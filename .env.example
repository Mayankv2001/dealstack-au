# DealStack AU — environment variables
# Copy to .env.local (which is gitignored) and fill in real values.
# Never commit real keys. The service-role key is server/script only.

# Public Supabase config (safe to expose to the browser; RLS-limited)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server/script ONLY — bypasses RLS. Do NOT prefix with NEXT_PUBLIC_.
# Used by scripts/seed.ts now, and admin server actions later.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin access is governed solely by the `admins` table in Supabase, checked
# by requireAdmin() (lib/admin/auth.ts), plus a hand-created Supabase Auth user
# for each admin. There is no env-var allowlist — no variable here grants or
# revokes admin access.

# Required in production. Launch-critical: sitemap, robots, canonical URLs, OG
# images and JSON-LD silently fall back to http://localhost:3000 when unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional (used in later phases)
# Force the static fallback even if Supabase is configured: static | supabase
# DATA_SOURCE=supabase

# Shared secret every cron route checks as `Authorization: Bearer ${CRON_SECRET}`
# (the daily offer-expiry cleanup and the gift-card jobs).
# Vercel Cron sends this automatically when the var is set in the project env. If
# it is unset, the routes return 503 and never run. Server-only secret — never
# prefix with NEXT_PUBLIC_.
# Vercel Cron runs /api/cron/daily-cleanup once daily (Hobby plan; keep
# vercel.json daily). The gift-card jobs are driven by GitHub Actions using the
# same token.
# CRON_SECRET=generate-a-long-random-string

# ── Gift-card ingest (GCDB) — SERVER/SCRIPT ONLY ─────────────────────────────
# An independently-gated ingestion pipeline. The gift-card ingest cron
# (app/api/cron/gift-card-ingest) reuses CRON_SECRET above
# for auth; it stages candidates for admin review and NEVER publishes. Both this
# master switch AND the gift_card_sources DB row (enabled + automated_fetch_allowed)
# must be on before any outbound request is made — see docs/gift-card-pipeline.md.
# Master switch — true only when exactly "true". Leave OFF until migration 021 is
# applied and the source's robots/terms have been reviewed.
GCDB_INGEST_ENABLED=false
# Feed URL. The DB source row is the default; this env var only overrides it.
GCDB_RSS_URL=https://gcdb.com.au/feed/
# Identifying User-Agent WITH a contact URL — REQUIRED when the ingest is enabled.
# Never a spoofed browser string. The route throws (fails closed) if it is missing.
GCDB_REQUEST_USER_AGENT=
# Hard cap on feed items processed per ingest run (default 40).
GCDB_MAX_ITEMS_PER_RUN=40

# ── Point Hacks weekly gift-card ingest — SERVER ONLY, DEFAULT OFF ───────────
# Independently gated from GCDB. The weekly cron (gift-card-weekly-ingest)
# reuses CRON_SECRET; it stages candidates for admin review and NEVER publishes.
# This switch AND the pointhacks_weekly_gift_cards DB source row (enabled +
# automated_fetch_allowed + recorded terms/robots reviews) must all be on before
# any outbound request is made. Leave OFF until migration 027 is applied and the
# source-permission review in docs/gift-card-source-policy.md is recorded.
POINTHACKS_WEEKLY_INGEST_ENABLED=false
# Identifying User-Agent WITH a contact URL — REQUIRED when the weekly ingest is
# enabled. The route throws (fails closed) if it is missing.
POINTHACKS_WEEKLY_REQUEST_USER_AGENT=
# Hard cap on weekly offers processed per run (default 10, max 20).
POINTHACKS_WEEKLY_MAX_ITEMS_PER_RUN=10

# ── Gift-card daily reconciliation — SERVER ONLY, DEFAULT OFF ────────────────
# Compares canonical offers with stored/approved source state and stages review
# candidates; it NEVER fetches from a closed source and NEVER publishes. Enabling
# it only activates the reconcile route's work — it opens no source/fetch gate.
# The daily GitHub trigger fires into this closed gate and no-ops until enabled.
GIFT_CARD_RECONCILE_ENABLED=false
# Once-per-day guard: minimum hours between real reconcile runs (default 20).
GIFT_CARD_RECONCILE_MIN_INTERVAL_HOURS=20

# ── Gift-card lifecycle — SERVER ONLY, DEFAULT OFF ───────────────────────────
# Activates only admin-approved future offers once their Sydney start arrives,
# and archives confirmed expired offers into immutable structured history.
# Requires reviewed migrations 023/025/030/031/032. It opens no source gate.
GIFT_CARD_LIFECYCLE_ENABLED=false

# Optional ops webhook (e.g. Slack incoming webhook URL) for server-error
# alerts. When set, errors captured by instrumentation.ts onRequestError are
# POSTed here (deduped per error digest, 5-minute window) in addition to the
# structured "[server-error]" lines always written to the function logs.
# Server-only secret — never prefix with NEXT_PUBLIC_.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
